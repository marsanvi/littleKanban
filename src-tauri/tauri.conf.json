{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "littleKanban",
  "version": "0.1.0",
  "identifier": "com.marsanvi.littlekanban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "littleKanban", "width": 1000, "height": 700 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"] }
}
